# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=crop_advisory

# Replace with a unique random value before deployment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-secret-before-use

# Include the exact browser origins used by Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ai-crop-advisory-ochre.vercel.app
MAX_UPLOAD_MB=8
